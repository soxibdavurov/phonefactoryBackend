# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring

# Domeningiz (www va https'siz). Sayt: https://DOMAIN, API va admin: https://api.DOMAIN
DOMAIN=phonefactory.uz

# Docker ichidagi MongoDB. MongoDB Atlas ishlatsangiz, o'sha URL'ni yozing
MONGO_URL=mongodb://mongo:27017/phonefactory

# Uzun tasodifiy qatorlar qo'ying:  openssl rand -hex 32
SESSION_SECRET=change-me
SECRET_TOKEN=change-me
