<%
  const packs = (typeof translations !== "undefined" && translations) ? translations : {};
  const textFields = fields || [];
  const languages = [
    { code: "ru", label: "Russian" },
    { code: "ko", label: "Korean" },
    { code: "uz", label: "Uzbek" },
  ];
%>
<style>
  .pf-translations { margin: 8px 0 18px; }
  .pf-translations .pf-lang-note { margin: 0 0 12px; color: #555; }
  .pf-translation-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .pf-translation-card { border: 1px solid #e4e4ea; border-radius: 12px; padding: 12px; background: #fafafc; }
  .pf-translation-card h4 { margin: 0 0 10px; font-size: 15px; }
  .pf-translation-card label { display: block; margin: 8px 0 4px; font-size: 13px; }
  .pf-translation-card input, .pf-translation-card textarea {
    width: 100%; border: 1px solid #ddd; border-radius: 6px; padding: 8px 10px; background: #fff;
  }
  .pf-translation-card textarea { min-height: 90px; }
  @media (max-width: 900px) {
    .pf-translation-grid { grid-template-columns: 1fr; }
  }
</style>
<div class="pf-translations">
  <p class="pf-lang-note">English is the default. Leave a language empty and the shop shows the English text.</p>
  <div class="pf-translation-grid">
    <% languages.forEach(function(language) { %>
      <section class="pf-translation-card">
        <h4><%= language.label %></h4>
        <% textFields.forEach(function(field) {
          const pack = packs[language.code] || {};
          const current = pack[field.key];
          const shown = Array.isArray(current) ? current.join(", ") : (current || "");
        %>
          <label><%= field.label %></label>
          <% if (field.type === "textarea") { %>
            <textarea name="<%= language.code %>_<%= field.key %>"><%= shown %></textarea>
          <% } else { %>
            <input type="text" name="<%= language.code %>_<%= field.key %>" value="<%= shown %>" />
          <% } %>
        <% }) %>
      </section>
    <% }) %>
  </div>
</div>
